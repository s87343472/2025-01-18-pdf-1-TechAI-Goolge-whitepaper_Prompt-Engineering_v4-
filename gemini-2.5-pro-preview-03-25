                             <thead>
                                <tr><th>目标</th><td>为第一人称射击视频游戏关卡编写故事情节。</td></tr>
                                <tr><th>模型</th><td>gemini-pro</td></tr>
                                <tr><th>Temperature</th><td>1</td><th>Token Limit</th><td>1024</td></tr>
                                <tr><th>Top-K</th><td>40</td><th>Top-P</th><td>0.8</td></tr>
                             </thead>
